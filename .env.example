# Copy to .env for local runs, or set these as Railway service variables.
# Flags override env; on Railway you set everything here.

# --- Railway (sandbox API) ---
# Provide ONE token. A project token is environment-scoped and preferred for
# deploys. Create it in Project Settings -> Tokens.
RAILWAY_PROJECT_TOKEN=
# ...or an account/workspace token instead:
# RAILWAY_API_TOKEN=
# Auto-injected by Railway at runtime; only set locally.
RAILWAY_ENVIRONMENT_ID=
# Override the API endpoint if needed (defaults to prod).
# RAILWAY_GRAPHQL_ENDPOINT=https://backboard.railway.com/graphql/v2

# --- GitHub (scale set registration) ---
# Required, no default (your repo/org/enterprise URL). e.g. https://github.com/my-org/my-repo
GITHUB_URL=
SCALE_SET_NAME=railway-runners
# RUNNER_LABELS=railway-runners,linux,x64
# RUNNER_GROUP=default

# Credentials: a PAT, or a GitHub App (App preferred).
GITHUB_TOKEN=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=

# --- Scaling / runner image ---
MIN_RUNNERS=0
MAX_RUNNERS=5
IDLE_TIMEOUT_MINUTES=30
# ENABLE_PRIVATE_NETWORKING=false
# Actions runner version; defaults to the latest release when unset.
# RUNNER_VERSION=

# --- Runner image tooling (baked into the prebuilt template) ---
# Docker is always included; dockerd starts in the runner for container/service jobs.
# Extra apt packages baked into the image (comma or space separated).
# EXTRA_PACKAGES=python3,ffmpeg
# Arbitrary shell run as the final image build step.
# EXTRA_SETUP=pip install uv

# LOG_LEVEL=info
# LOG_FORMAT=json
