# Shared Railway connection
RAILWAY_PROJECT_TOKEN=
# Or use an account/workspace token:
# RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
LOG_FORMAT=json
PORT=8080

# Choose one provider subcommand.

# --- GitHub mode ---
GITHUB_URL=https://github.com/my-org/my-repo
GITHUB_SCALE_SET_NAME=railway-runners
GITHUB_MAX_RUNNERS=5
# GITHUB_RUNNER_LABELS=railway-runners,linux-x64
# GITHUB_RUNNER_VERSION=2.331.0
GITHUB_TOKEN=
# Or use a GitHub App:
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=

# --- Forgejo mode ---
# FORGEJO_URL=https://forgejo.example.com
# FORGEJO_API_TOKEN=
# FORGEJO_RUNNER_LABELS=railway-ubuntu:host
# FORGEJO_JOB_LABEL_FILTER=railway-ubuntu
# FORGEJO_RUNNER_VERSION=11.0.1
# MAX_CONCURRENT_SANDBOXES=10
# MAX_LAUNCH_PER_POLL=2
# POLL_INTERVAL_SECONDS=5
# SANDBOX_IDLE_TIMEOUT_MINUTES=10
# RUNNER_TIMEOUT_SECONDS=7200

# TAILSCALE_TAILNET=example.ts.net
# TAILSCALE_OAUTH_CLIENT_ID=
# TAILSCALE_OAUTH_CLIENT_SECRET=
# TAILSCALE_TAG=tag:railway-forgejo-runner
# TAILSCALE_KEY_EXPIRY_SECONDS=600

# Forgejo checkpoint/cache customization
# EXTRA_PACKAGES=build-essential git-lfs python3 ripgrep
# EXTRA_SETUP=\
#   npm install -g pnpm
# PRELOAD_DOCKER_IMAGES=python:3.12-trixie ghcr.io/astral-sh/uv:latest
# DOCKER_WARMUP_SETUP=
# SNAPSHOT_REFRESH_HOURS=24
# RUNNER_SNAPSHOT_NAME_PREFIX=forgejo-runner
# SNAPSHOT_BUILD_TIMEOUT_SECONDS=1800
# RETAINED_RUNNER_SNAPSHOTS=3
# SNAPSHOT_AFTER_DEFAULT_BRANCH_BUILD=true

# Giving job sandboxes access to Railway private services widens their reach.
ENABLE_PRIVATE_NETWORKING=false
